  };
  
  if (cacheTtlSec > 0) {
    headers["Cache-Control"] = `public, max-age=${cacheTtlSec}, stale-while-revalidate=${cacheTtlSec * 2}`;
  }

  return new Response(JSON.stringify(data), { headers });
}

function notFound() {
  return new Response("Not Found", { status: 404, headers: CORS_HEADERS });
}

function absImg(path) {
  if (!path) return "";
  if (path.startsWith("http://") || path.startsWith("https://")) return path;
  return `${IMG_CDN}/${path.replace(/^\/+/, "")}`;
}

function extractM3u8FromEmbed(embedUrl) {
  if (!embedUrl) return null;
  try {
    const u = new URL(embedUrl);
    const inner = u.searchParams.get("url");
    return inner ? decodeURIComponent(inner) : null;
  } catch {
    return null;
  }
}

// Fetch dữ liệu tối ưu Cache trên Cloudflare CDN
async function fetchJSON(url, cacheTtl = 300) {
  const res = await fetch(url, {
    headers: {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
      "Referer": `${API_BASE}/`,
    },
    cf: {
      cacheTtl: cacheTtl,
      cacheEverything: true,
    },
  });
  if (!res.ok) throw new Error(`Fetch failed ${res.status}: ${url}`);
  return res.json();
}

function buildManifest() {
  const genreOptions = [
    ...GENRES.map((g) => g.name),
    ...COUNTRIES.map((c) => `Quốc gia: ${c.name}`),
    ...YEARS.map((y) => `Năm: ${y}`)
  ];

  return {
    id: ADDON_ID,
    version: ADDON_VERSION,
    name: ADDON_NAME,
    description: "Xem phim Vietsub/Thuyết Minh từ KKPHIM (phimapi.com)",
    logo: "https://phimapi.com/favicon.ico",
    resources: ["catalog", "meta", "stream"],
    types: ["movie", "series"],
    idPrefixes: ["kkphim:"],
    catalogs: CATALOGS.map((c) => ({
      type: c.stremioType,
      id: `kkphim-${c.id}-${c.stremioType}`,
      name: c.name,
      extra: [
        { name: "search", isRequired: false },
        { name: "genre", isRequired: false, options: genreOptions },
        { name: "skip", isRequired: false },
      ],
    })),
    behaviorHints: { configurable: false },
  };
}

function itemToPreview(item, stremioType) {
  return {
    id: `kkphim:${item.slug}`,
    type: stremioType,
    name: item.name,
    poster: absImg(item.poster_url || item.thumb_url),
    posterShape: "poster",
    background: absImg(item.thumb_url || item.poster_url),
    releaseInfo: item.year ? String(item.year) : undefined,
    description: item.origin_name || item.name,
    genres: (item.category || []).map((c) => c.name),
  };
}

function itemStremioType(item) {
  return (item.type === "series" || item.type === "hoathinh" && item.episode_total !== "1") ? "series" : "movie";
}

function buildApiUrl(catalogSlug, page, search, genreSlug, countrySlug, year) {
  if (search) {
    return `${API_BASE}/v1/api/tim-kiem?keyword=${encodeURIComponent(search)}&page=${page}`;
  }
  
  let url = `${API_BASE}/v1/api/danh-sach/`;
  if (catalogSlug === "phim-moi-cap-nhat") {
    url = `${API_BASE}/v1/api/danh-sach?page=${page}`;
  } else {
    url += `${catalogSlug}?page=${page}&sort_field=modified.time&sort_type=desc`;
  }

  if (genreSlug) url += `&category=${genreSlug}`;
  if (countrySlug) url += `&country=${countrySlug}`;
  if (year) url += `&year=${year}`;

  return url;
}

async function handleCatalog(catalogSlug, stremioType, searchParams) {
  const search = searchParams.get("search");
  const rawGenre = searchParams.get("genre");
  const skip = parseInt(searchParams.get("skip") || "0", 10);
  
  let genreSlug = null;
  let countrySlug = null;
  let yearParam = null;

  // Phân tích tham số Genre lọc nâng cao
  if (rawGenre) {
    if (rawGenre.startsWith("Quốc gia: ")) {
      const cName = rawGenre.replace("Quốc gia: ", "");
      countrySlug = COUNTRY_SLUG_BY_NAME[cName];
    } else if (rawGenre.startsWith("Năm: ")) {
      yearParam = rawGenre.replace("Năm: ", "");
    } else {
      genreSlug = GENRE_SLUG_BY_NAME[rawGenre];
    }
  }

  const startPage = Math.floor(skip / 24) + 1;

  // Tải dữ liệu song song 2 trang để tăng hiệu năng và độ mượt khi cuộn danh sách
  const urls = [
    buildApiUrl(catalogSlug, startPage, search, genreSlug, countrySlug, yearParam),
    buildApiUrl(catalogSlug, startPage + 1, search, genreSlug, countrySlug, yearParam)
  ];

  const results = await Promise.allSettled(urls.map((u) => fetchJSON(u, CACHE_CATALOG_SEC)));
  let rawItems = [];

  for (const res of results) {
    if (res.status === "fulfilled") {
      const items = res.value?.data?.items || res.value?.items || [];
      rawItems.push(...items);
    }
  }

  // Lọc đúng định dạng Type (Movie/Series)
  const filtered = rawItems.filter((it) => {
    const t = itemStremioType(it);
    return stremioType === "movie" ? t === "movie" : t === "series";
  });

  const metas = filtered.slice(0, 20).map((it) => itemToPreview(it, stremioType));
  return json({ metas }, CACHE_CATALOG_SEC);
}

async function handleMeta(slug) {
  const data = await fetchJSON(`${API_BASE}/phim/${slug}`, CACHE_META_SEC);
  if (!data?.status || !data.movie) return notFound();

  const movie = data.movie;
  const episodesRaw = data.episodes || [];
  const isSeries = movie.type === "series" || movie.type === "hoathinh" || episodesRaw.some((s) => (s.server_data || []).length > 1);

  const meta = {
    id: `kkphim:${slug}`,
    type: isSeries ? "series" : "movie",
    name: movie.name,
    poster: absImg(movie.poster_url || movie.thumb_url),
    background: absImg(movie.thumb_url || movie.poster_url),
    description: (movie.content || "").replace(/<[^>]+>/g, "").trim(),
    releaseInfo: movie.year ? String(movie.year) : undefined,
    imdbRating: movie.imdb?.vote_average ? String(movie.imdb.vote_average) : undefined,
    genres: (movie.category || []).map((c) => c.name),
    country: (movie.country || []).map((c) => c.name).join(", "),
    runtime: movie.time,
    cast: movie.actor || [],
    director: (movie.director || []).filter((d) => d && d !== "Đang cập nhật"),
  };

  if (isSeries) {
    let maxEpServer = episodesRaw[0];
    for (const server of episodesRaw) {
      if ((server.server_data?.length || 0) > (maxEpServer?.server_data?.length || 0)) {
        maxEpServer = server;
      }
    }

    const epList = maxEpServer?.server_data || [];
    meta.videos = epList.map((ep, idx) => ({
      id: `kkphim:${slug}:1:${idx + 1}`,
      title: ep.name ? (ep.name.toLowerCase().includes("tập") ? ep.name : `Tập ${ep.name}`) : `Tập ${idx + 1}`,
      season: 1,
      episode: idx + 1,
      released: movie.created?.time || undefined,
    }));
  }

  return json({ meta }, CACHE_META_SEC);
}

function resolveStreamUrl(serverDataEntry) {
  if (serverDataEntry.link_m3u8) return serverDataEntry.link_m3u8;
  return extractM3u8FromEmbed(serverDataEntry.link_embed);
}

async function handleStream(slug, episode) {
  const data = await fetchJSON(`${API_BASE}/phim/${slug}`, CACHE_STREAM_SEC);
  if (!data?.status || !data.episodes) return json({ streams: [] });

  const epIndex = episode ? episode - 1 : 0;
  const streams = [];

  for (const server of data.episodes) {
    const entry = server.server_data?.[epIndex];
    if (!entry) continue;
    
    const m3u8 = resolveStreamUrl(entry);
    if (!m3u8) continue;

    streams.push({
      name: `KKPHIM`,
      title: `[${server.server_name}] ${entry.filename || entry.name || ''}`.trim(),
      url: m3u8,
      behaviorHints: {
        notWebReady: false,
        bingeGroup: `kkphim-${slug}`,
      },
    });
  }

  return json({ streams }, CACHE_STREAM_SEC);
}

async function router(request) {
  const url = new URL(request.url);
  const path = decodeURIComponent(url.pathname);

  if (request.method === "OPTIONS") {
    return new Response(null, { headers: CORS_HEADERS });
  }

  if (path === "/" || path === "") {
    return new Response(
      `<h1>${ADDON_NAME} Stremio Addon</h1><p>Link cài đặt vào Stremio: <a href="stremio://${url.host}/manifest.json">${url.origin}/manifest.json</a></p>`,
      { headers: { "Content-Type": "text/html; charset=utf-8" } }
    );
  }

  if (path === "/manifest.json") {
    return json(buildManifest(), 86400);
  }

  let m = path.match(/^\/catalog\/(movie|series)\/kkphim-([a-z-]+)-(movie|series)(?:\/(.+))?\.json$/);
  if (m) {
    const [, , catalogSlug, , extraStr] = m;
    const params = new URLSearchParams(url.search);
    
    if (extraStr) {
      const extraParams = new URLSearchParams(extraStr);
      for (const [key, value] of extraParams.entries()) {
        params.set(key, value);
      }
    }
    
    const stremioType = m[1];
    try {
      return await handleCatalog(catalogSlug, stremioType, params);
    } catch (e) {
      return json({ metas: [], error: String(e) });
    }
  }

  m = path.match(/^\/meta\/(movie|series)\/kkphim:([^/.]+)\.json$/);
  if (m) {
    try {
      return await handleMeta(m[2]);
    } catch (e) {
      return json({ meta: null, error: String(e) });
    }
  }

  m = path.match(/^\/stream\/(movie|series)\/kkphim:([^/:]+)(?::(\d+):(\d+))?\.json$/);
  if (m) {
    const [, , slug, , episode] = m;
    try {
      return await handleStream(slug, episode ? parseInt(episode, 10) : undefined);
    } catch (e) {
      return json({ streams: [], error: String(e) });
    }
  }

  return notFound();
}
